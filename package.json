{
	"name": "mylogs-obsidian",
	"version": "0.32.0",
	"description": "MyLogs: Obsidian plugin for the MyLogs bullet-journal vault (Daily Pad view).",
	"main": "main.js",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "node --test \"test/**/*.test.ts\""
	},
	"engines": {
		"node": ">=22.18"
	},
	"keywords": [
		"obsidian",
		"bullet-journal",
		"daily-note"
	],
	"author": "Yoonwoo Lee",
	"license": "UNLICENSED",
	"devDependencies": {
		"@types/node": "^22.20.5",
		"esbuild": "0.28.2",
		"obsidian": "1.14.4",
		"tslib": "^2.8.1",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "^0.3.312",
		"@openai/codex-sdk": "^0.165.0",
		"zod": "^4.6.7"
	}
}
